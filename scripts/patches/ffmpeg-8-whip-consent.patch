+/* Only a fresh, authenticated response to our own probe renews consent. */
+static int ice_consent_response(AVFormatContext *s, const uint8_t *buf, int size)
+{
+    WHIPContext *whip = s->priv_data;
+    int slot, pos, len, i, difference;
+    int64_t now = av_gettime_relative();
+    uint8_t header[20], digest[20];
+    AVHMAC *hmac;
+
+    if (!ice_is_binding_response((uint8_t *)buf, size) ||
+        AV_RB32(buf + 4) != STUN_MAGIC_COOKIE ||
+        AV_RB16(buf + 2) + 20 != size || (size & 3))
+        return 0;
+
+    for (slot = 0; slot < FF_ARRAY_ELEMS(whip->consent_tid); slot++) {
+        if (whip->consent_sent[slot] &&
+            now - whip->consent_sent[slot] <= (int64_t)whip->consent_timeout * 1000 &&
+            !memcmp(buf + 8, whip->consent_tid[slot], 12))
+            break;
+    }
+    if (slot == FF_ARRAY_ELEMS(whip->consent_tid))
+        return 0;
+
+    for (pos = 20; pos + 4 <= size; pos += 4 + ((len + 3) & ~3)) {
+        len = AV_RB16(buf + pos + 2);
+        if (len > size - pos - 4)
+            return 0;
+        if (AV_RB16(buf + pos) != STUN_ATTR_MESSAGE_INTEGRITY)
+            continue;
+        if (len != 20)
+            return 0;
+        hmac = av_hmac_alloc(AV_HMAC_SHA1);
+        if (!hmac)
+            return AVERROR(ENOMEM);
+        memcpy(header, buf, sizeof(header));
+        /* RFC 5389: header length includes MESSAGE-INTEGRITY, HMAC input excludes it. */
+        AV_WB16(header + 2, pos + 4);
+        av_hmac_init(hmac, whip->ice_pwd_remote, strlen(whip->ice_pwd_remote));
+        av_hmac_update(hmac, header, sizeof(header));
+        av_hmac_update(hmac, buf + 20, pos - 20);
+        av_hmac_final(hmac, digest, sizeof(digest));
+        av_hmac_free(hmac);
+        difference = 0;
+        for (i = 0; i < sizeof(digest); i++)
+            difference |= digest[i] ^ buf[pos + 4 + i];
+        if (difference)
+            return 0;
+        whip->consent_sent[slot] = 0; /* A replay cannot renew consent twice. */
+        whip->consent_last_response = now;
+        return 0;
+    }
+    return 0;
+}
+
+static int ice_consent_poll(AVFormatContext *s)
+{
+    WHIPContext *whip = s->priv_data;
+    int i, ret, size;
+    int64_t now;
+
+    /* Bound work per call so unsolicited UDP traffic cannot starve media or stop. */
+    for (i = 0; i < 32; i++) {
+        ret = ffurl_read(whip->udp, whip->buf, sizeof(whip->buf));
+        if (ret == AVERROR(EAGAIN))
+            break;
+        if (ret < 0)
+            return ret;
+        if (ice_is_binding_response(whip->buf, ret)) {
+            if ((ret = ice_consent_response(s, whip->buf, ret)) < 0)
+                return ret;
+        } else if (ice_is_binding_request(whip->buf, ret)) {
+            if ((ret = ice_handle_binding_request(s, whip->buf, ret)) < 0)
+                return ret;
+        } else if (is_dtls_packet(whip->buf, ret)) {
+            if ((ret = ffurl_write(whip->dtls_uc, whip->buf, ret)) < 0)
+                return ret;
+        }
+    }
+
+    now = av_gettime_relative();
+    if (now - whip->consent_last_response >= (int64_t)whip->consent_timeout * 1000) {
+        av_log(whip, AV_LOG_ERROR, "WHIP ICE consent expired after %d ms\n", whip->consent_timeout);
+        return AVERROR(ETIMEDOUT);
+    }
+    if (now >= whip->consent_next_probe) {
+        unsigned slot = whip->consent_slot++ % FF_ARRAY_ELEMS(whip->consent_tid);
+        if ((ret = ice_create_request(s, whip->buf, sizeof(whip->buf), &size)) < 0)
+            return ret;
+        memcpy(whip->consent_tid[slot], whip->buf + 8, 12);
+        whip->consent_sent[slot] = now;
+        if ((ret = ffurl_write(whip->udp, whip->buf, size)) < 0)
+            return ret;
+        whip->consent_next_probe = now + FFMIN(1000, whip->consent_timeout / 3) * 1000;
+    }
     return 0;
 }

